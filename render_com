"""Dispara builder+render em background e monitora ate conclusao"""
import subprocess, json, os, time, sys
sys.stdout.reconfigure(encoding="utf-8")
os.chdir("c:/ultracut3")

from pathlib import Path
from config import FFMPEG_PATH, FFPROBE_PATH, PROJETOS_DIR, OUTPUT_DIR
from services.event_logger import log_event

pr = "teste_e2e_video1"
pd = PROJETOS_DIR / pr

# 1. Verifica se midias existem
midias_file = pd / "midias_encontradas.json"
if not midias_file.exists():
    print("ERRO: midias_encontradas.json nao encontrado")
    sys.exit(1)

midias = json.loads(open(str(midias_file), encoding="utf-8").read())
cenas = json.loads(open(str(pd / "cenas.json"), encoding="utf-8").read())
cache = pd / "_processed"
cache.mkdir(parents=True, exist_ok=True)

green = sum(1 for m in midias if m.get("quality") == "green")
print(f"Midias carregadas: {len(midias)}, GREEN={green}")
print(f"FFMPEG_PATH={FFMPEG_PATH}")
print(f"FFPROBE_PATH={FFPROBE_PATH}")
print(f"Cache dir: {cache}")
sys.stdout.flush()

# 2. Builder: converte cada JPG para MP4 em sequencia (processo unico)
log_event("RENDER", "Iniciando builder (foto->video)...", level="info")
pro = []
t0 = time.time()

for mi in midias:
    if mi.get("success") and mi.get("arquivo") and Path(mi["arquivo"]).exists():
        sid = mi.get("scene_id", 0)
        saida = cache / f"scene_{sid}.mp4"
        if not saida.exists():
            # Calcula duracao da cena
            d = 4.0
            for c in cenas:
                if c["id"] == sid and c.get("timestamps"):
                    ts = c["timestamps"]
                    ini = int(ts[0].split(":")[0]) * 60 + int(ts[0].split(":")[1])
                    fim = int(ts[-1].split(":")[0]) * 60 + int(ts[-1].split(":")[1]) + 5
                    d = max(fim - ini, 3.0)
            
            # Converte foto -> video com redimensionamento ja incluso no -vf
            # O -vf ja faz scale=1920:1080 + pad, entao o JPG original grande
            # e redimensionado antes do encoding
            size_mb = Path(mi["arquivo"]).stat().st_size / 1024 / 1024
            print(f"Cena {sid}: foto={size_mb:.0f}MB duracao={d:.0f}s convertendo...", flush=True)
            
            result = subprocess.run([
                FFMPEG_PATH, "-y",
                "-loop", "1",
                "-i", mi["arquivo"],
                "-t", str(d),
                "-vf", "scale=1920:1080:force_original_aspect_ratio=1,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,setsar=1:1",
                "-pix_fmt", "yuv420p",
                "-c:v", "libx264",
                "-preset", "fast",
                "-crf", "23",
                str(saida)
            ], capture_output=True, text=True, timeout=600)
            
            if result.returncode != 0:
                print(f"  ERRO: {result.stderr[-200:]}", flush=True)
                log_event("RENDER", f"Erro convertendo cena {sid}: {result.stderr[-100:]}", level="error")
                continue
            else:
                out_size = saida.stat().st_size / 1024 / 1024
                print(f"  OK: {out_size:.1f}MB (reduzido de {size_mb:.0f}MB)", flush=True)
        
        pro.append(str(saida))

tb = time.time() - t0
print(f"Builder: {len(pro)} clips em {tb:.1f}s", flush=True)
log_event("RENDER", f"Builder concluido: {len(pro)} clips em {tb:.1f}s", level="info")

# 3. Render: concatena clips + audio
if pro:
    audio = str(pd / "audio_original.mp4")
    if not Path(audio).exists():
        print("ERRO: audio_original.mp4 nao encontrado", flush=True)
        sys.exit(1)
    
    print("Render: concatenando clips + audio...", flush=True)
    log_event("RENDER", "Iniciando render (concat+audio)...", level="info")
    t0 = time.time()
    
    concat_file = OUTPUT_DIR / f"{pr}_concat.txt"
    with open(concat_file, "w") as f:
        for a in pro:
            f.write(f"file '{Path(a).resolve()}'\n")
    
    tmp = OUTPUT_DIR / f"{pr}.tmp.mp4"
    final = OUTPUT_DIR / f"{pr}.mp4"
    if final.exists():
        final.unlink()
    
    result = subprocess.run([
        FFMPEG_PATH, "-y",
        "-f", "concat", "-safe", "0",
        "-i", str(concat_file),
        "-i", audio,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-profile:v", "main",
        "-movflags", "+faststart",
        "-c:a", "aac", "-b:a", "192k",
        "-map", "0:v:0",
        "-map", "1:a:0",
        "-shortest",
        str(tmp)
    ], capture_output=True, text=True, timeout=1200)
    
    tr = time.time() - t0
    
    if result.returncode == 0:
        tmp.rename(final)
        sz = final.stat().st_size
        sz_mb = sz / 1024 / 1024
        print(f"Render OK! {final} ({sz_mb:.1f}MB, {sz:,} bytes)", flush=True)
        print(f"Tempo render: {tr:.1f}s", flush=True)
        log_event("RENDER", f"Render concluido: {sz:,} bytes em {tr:.1f}s", level="info")
        
        # Validacao
        dur = subprocess.run([FFPROBE_PATH, "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(final)],
                           capture_output=True, text=True, timeout=10)
        st = subprocess.run([FFPROBE_PATH, "-v", "error", "-show_entries", "stream=codec_type,pix_fmt,profile", "-of", "json", str(final)],
                          capture_output=True, text=True, timeout=10)
        data = json.loads(st.stdout)
        duracao = float(dur.stdout.strip())
        print(f"\n=== VALIDACAO FFMPEG ===")
        print(f"Arquivo: {final}")
        print(f"Tamanho: {sz_mb:.1f}MB")
        print(f"Duracao: {duracao:.1f}s (audio original: 150.4s)")
        print(f"Streams: {json.dumps(data, indent=2)}")
        for stream in data.get("streams", []):
            if stream.get("codec_type") == "video":
                print(f"Video: pix_fmt={stream.get('pix_fmt')} profile={stream.get('profile')}")
                if stream.get("pix_fmt") == "yuv420p" and "Main" in str(stream.get("profile", "")):
                    print("VALIDACAO: yuv420p + Main profile OK")
                else:
                    print(f"VALIDACAO: formato inesperado")
            elif stream.get("codec_type") == "audio":
                print(f"Audio: 1 stream (narracao original apenas) - OK")
        
        # Extrai frames para confirmar que nao ha tela preta
        print("\nFrames de verificacao:")
        for j in [0, 75, 150]:
            fr = OUTPUT_DIR / f"frame_v{j}.jpg"
            subprocess.run([FFMPEG_PATH, "-y", "-ss", str(j), "-i", str(final), "-frames:v", "1", str(fr)],
                          capture_output=True, timeout=30)
            fsz = fr.stat().st_size if fr.exists() else 0
            print(f"  Frame {j}s: {fsz:,} bytes {'OK' if fsz > 1000 else 'PRETA?'}")
        
        print("\n=== RENDER CONCLUIDO COM SUCESSO ===")
    else:
        print(f"Render ERRO: {result.stderr[-500:]}", flush=True)
        log_event("RENDER", f"Render falhou: {result.stderr[-100:]}", level="error")
    
    if concat_file.exists():
        concat_file.unlink()
else:
    print("Nenhum clip para renderizar", flush=True)