import sys, json, shutil, os, time
sys.stdout.reconfigure(encoding='utf-8')
os.chdir('c:/ultracut3')

from pathlib import Path
from config import PROJETOS_DIR

project = 'teste_e2e_video1'
proj_dir = PROJETOS_DIR / project
if proj_dir.exists():
    shutil.rmtree(str(proj_dir))
proj_dir.mkdir(parents=True, exist_ok=True)

start_all = time.time()

# 1. COPIA AUDIO
src_audio = Path('c:/ultracut3/video1/teste1.mp3')
dst_audio = proj_dir / 'audio_original.mp4'
shutil.copy2(str(src_audio), str(dst_audio))
print(f"[1/5] Audio copiado: {dst_audio} ({dst_audio.stat().st_size} bytes)")

# 2. TRANSCREVER
print("[2/5] Iniciando transcricao...")
t0 = time.time()
from services.transcriber import transcrever
result_trans = transcrever(project, str(dst_audio))
t_trans = time.time() - t0
print(f"  Transcrito: {result_trans.get('success')}")
print(f"  Segmentos: {result_trans.get('segments', '?')}")
print(f"  Duracao audio: {result_trans.get('duration', '?'):.1f}s")
print(f"  Idioma: {result_trans.get('language', '?')}")
print(f"  Tempo: {t_trans:.1f}s")

# 3. GERAR CENAS
print("[3/5] Gerando cenas...")
t0 = time.time()
from services.scene_builder import gerar_cenas
result_cenas = gerar_cenas(project)
t_cenas = time.time() - t0
print(f"  Cenas geradas: {result_cenas.get('cenas_count', '?')}")
print(f"  Tempo: {t_cenas:.1f}s")

# 4. STORYBOARD (fallback local)
print("[4/5] Gerando storyboard + keywords...")
t0 = time.time()
from services.broll_director import gerar_storyboard
result_story = gerar_storyboard(project, usar_claude=False)  # fallback local
t_story = time.time() - t0
print(f"  Storyboard gerado: {result_story.get('cenas_count', '?')}")
print(f"  Camada: {result_story.get('camada', '?')}")
print(f"  Tempo: {t_story:.1f}s")

# 5. BUSCAR MIDIAS
print("[5/5] Buscando midias...")
t0 = time.time()
from services.media_search import buscar_midias_projeto
result_midias = buscar_midias_projeto(project)
t_midias = time.time() - t0
print(f"  Total cenas: {result_midias.get('total_scenes', '?')}")
print(f"  GREEN: {result_midias.get('green', 0)}")
print(f"  NEEDS_MEDIA: {result_midias.get('needs_media', 0)}")
print(f"  Tempo: {t_midias:.1f}s")

# Detalhes por cena
for r in result_midias.get('resultados', []):
    if r.get('success'):
        print(f"    Cena {r.get('scene_id','?')}: GREEN | {r.get('source','?'):7s} | {r.get('width','?'):5d}x{r.get('height','?'):5d}")
    else:
        print(f"    Cena {r.get('scene_id','?')}: {'FALHOU':7s} | quality={r.get('quality','?')} motivo={r.get('reason','?')} needs_media={r.get('needs_media','?')}")

# 6. VIDEO BUILDER
print("[6/6] Montando video...")
t0 = time.time()
from services.video_builder import construir_video
result_build = construir_video(project)
print(f"  Cenas com midia: {result_build.get('cenas_com_midia', 0)}")
print(f"  Cenas sem midia: {result_build.get('cenas_sem_midia', 0)}")
print(f"  Audio: {result_build.get('arquivo_audio', 'N/A')}")
arquivos = result_build.get('arquivos_video', [])
print(f"  Arquivos de video: {len(arquivos)}")
for a in arquivos[:5]:
    print(f"    {a}")

# 7. RENDER
if arquivos and result_build.get('arquivo_audio'):
    print("\nRenderizando video final...")
    from services.video_encoder import renderizar_video
    result_render = renderizar_video(arquivos, result_build['arquivo_audio'], project)
    print(f"  Render success: {result_render.get('success')}")
    print(f"  Arquivo: {result_render.get('arquivo', 'N/A')}")
    print(f"  Tamanho: {result_render.get('tamanho', 0)} bytes")
    if not result_render.get('success'):
        print(f"  Erro: {result_render.get('error', '?')}")
else:
    print("\n[AVISO] Pulando render: sem midias ou sem audio")

total = time.time() - start_all
print(f"\n--- TEMPO TOTAL: {total:.1f}s ---")